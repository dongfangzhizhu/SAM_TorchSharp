@model IReadOnlyList<WebDemo.Models.ModelAvailability>
@using System.IO
@{ Layout = null; }
<!doctype html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SAM TorchSharp WebDemo</title>
    <style>
        :root { color-scheme: light dark; font-family: system-ui, sans-serif; }
        body { max-width: 1200px; margin: auto; padding: 24px; }
        header, .toolbar, .status { margin-bottom: 18px; }
        .toolbar { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; padding: 14px; border: 1px solid #8886; border-radius: 10px; }
        button, select, input { padding: 8px 12px; }
        .workspace { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
        .panel { min-height: 460px; border: 2px dashed #8888; border-radius: 12px; padding: 12px; display: flex; flex-direction: column; align-items: center; }
        .canvas-wrap { position: relative; max-width: 100%; margin: auto; }
        #preview { display: block; max-width: 100%; max-height: 520px; }
        #canvas { position: absolute; inset: 0; cursor: crosshair; }
        #result { max-width: 100%; max-height: 520px; margin: auto; }
        #details { width: 100%; white-space: pre-wrap; overflow-wrap: anywhere; }
        .ok { color: #16833c; } .missing, .error { color: #c33; }
        .hint { opacity: .75; font-size: .92rem; }
        [hidden] { display: none !important; }
        @@media (max-width: 800px) { .workspace { grid-template-columns: 1fr; } }
    </style>
</head>
<body>
    <header><h1>SAM TorchSharp WebDemo</h1><p>逐项测试 SAM、SAM 2、SAM 2.1 点/框分割及 SAM 3、SAM 3.1 文本 detector-only 推理。</p></header>
    <section class="status">
        @foreach (var item in Model)
        {
            <div class="@(item.Available ? "ok" : "missing")">@(item.Available ? "✓" : "✗") @item.Name — @item.Status@(string.IsNullOrEmpty(item.CheckpointPath) ? "" : $" / {System.IO.Path.GetFileName(item.CheckpointPath)}")（@item.PromptType 提示）</div>
        }
        <div class="hint">在 appsettings.json 的 Models.Sam、Sam2、Sam21、Sam3、Sam31 中分别设置 Directory 与 Name；任一为空时该模型不可用。</div>
    </section>
    <section class="toolbar">
        <label>模型 <select id="model">@foreach (var item in Model) { if (item.Available) { <option value="@item.Id">@item.Name</option> } else { <option value="@item.Id" disabled>@item.Name（@item.Status）</option> } }</select></label>
        <input type="file" id="upload" accept="image/*" />
        <span id="geometryTools">
            <label><input type="radio" name="tool" value="foreground" checked /> 前景点</label>
            <label><input type="radio" name="tool" value="background" /> 背景点</label>
            <label><input type="radio" name="tool" value="rectangle" /> 矩形</label>
        </span>
        <label id="captionTool" hidden>文本提示 <input id="caption" value="shoe" maxlength="200" /></label>
        <button id="clear" type="button">清除标注</button><button id="predict" type="button">运行当前模型</button><button id="predictAll" type="button">测试全部可用模型</button>
    </section>
    <main class="workspace">
        <section class="panel"><h2>输入与提示</h2><div class="canvas-wrap"><img id="preview" alt="上传图片预览" /><canvas id="canvas"></canvas></div><p>请选择图片，再点击添加点或拖动绘制矩形。</p></section>
        <section class="panel"><h2>输出</h2><img id="result" alt="预测结果" hidden /><pre id="details">预测结果将在此显示。</pre></section>
    </main>
    <script>
        const model = document.querySelector('#model'), upload = document.querySelector('#upload'), preview = document.querySelector('#preview');
        const canvas = document.querySelector('#canvas'), context = canvas.getContext('2d'), details = document.querySelector('#details');
        const result = document.querySelector('#result'), predict = document.querySelector('#predict'), predictAll = document.querySelector('#predictAll');
        const availableModels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Where(x => x.Available).Select(x => new { id = x.Id, name = x.Name })));
        if (availableModels.length) model.value = availableModels[0].id;
        let annotations = [], start = null;
        function isSam3(value = model.value) { return value === 'sam3' || value === 'sam3.1'; }
        const currentTool = () => document.querySelector('input[name=tool]:checked').value;
        const position = event => { const rect = canvas.getBoundingClientRect(); return { x: event.clientX - rect.left, y: event.clientY - rect.top }; };
        function render() {
            context.clearRect(0, 0, canvas.width, canvas.height); context.lineWidth = 3;
            for (const a of annotations) {
                context.strokeStyle = a.type === 'foreground' ? '#00e676' : a.type === 'background' ? '#ff1744' : '#00b0ff';
                if (a.type === 'rectangle') context.strokeRect(a.x1, a.y1, a.x2 - a.x1, a.y2 - a.y1);
                else { context.beginPath(); context.arc(a.x, a.y, 6, 0, Math.PI * 2); context.stroke(); }
            }
        }
        function syncCanvas() { canvas.width = preview.clientWidth; canvas.height = preview.clientHeight; render(); }
        function clearOutput() { result.hidden = true; result.removeAttribute('src'); details.textContent = '预测结果将在此显示。'; }
        function syncPromptTools() {
            document.querySelector('#geometryTools').hidden = isSam3(); document.querySelector('#captionTool').hidden = !isSam3();
            canvas.style.pointerEvents = isSam3() ? 'none' : 'auto';
        }
        upload.addEventListener('change', () => {
            const file = upload.files[0]; if (!file) return;
            if (file.size > 20 * 1024 * 1024) { details.textContent = '图片不能超过 20 MB。'; return; }
            const reader = new FileReader(); reader.onload = () => { preview.onload = syncCanvas; preview.src = reader.result; annotations = []; clearOutput(); }; reader.readAsDataURL(file);
        });
        canvas.addEventListener('pointerdown', event => {
            if (isSam3() || !preview.src) return; const point = position(event);
            if (currentTool() === 'rectangle') start = point; else { annotations.push({ type: currentTool(), x: point.x, y: point.y }); render(); }
        });
        canvas.addEventListener('pointerup', event => {
            if (!start) return; const end = position(event); annotations = annotations.filter(x => x.type !== 'rectangle');
            annotations.push({ type: 'rectangle', x1: Math.min(start.x, end.x), y1: Math.min(start.y, end.y), x2: Math.max(start.x, end.x), y2: Math.max(start.y, end.y) }); start = null; render();
        });
        document.querySelector('#clear').addEventListener('click', () => { annotations = []; render(); clearOutput(); });
        model.addEventListener('change', () => {
            syncPromptTools(); annotations = []; render(); clearOutput();
        });
        syncPromptTools();
        window.addEventListener('resize', syncCanvas);
        function correctedAnnotations() {
            const ratio = { x: preview.naturalWidth / canvas.width, y: preview.naturalHeight / canvas.height };
            return annotations.map(a => a.type === 'rectangle'
                ? { type: a.type, x1: Math.round(a.x1 * ratio.x), y1: Math.round(a.y1 * ratio.y), x2: Math.round(a.x2 * ratio.x), y2: Math.round(a.y2 * ratio.y) }
                : { type: a.type, x: Math.round(a.x * ratio.x), y: Math.round(a.y * ratio.y) });
        }
        async function runModel(modelId) {
            const response = await fetch('/home/predict', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ model: modelId, image: preview.src, caption: document.querySelector('#caption').value, annotations: correctedAnnotations() }) });
            const payload = await response.json(); if (!response.ok) throw new Error(payload.error || `HTTP ${response.status}`);
            return payload;
        }
        predict.addEventListener('click', async () => {
            if (!preview.src) { details.textContent = '请先选择图片。'; return; }
            predict.disabled = true; details.textContent = '正在加载模型并推理，请稍候…';
            try {
                const payload = await runModel(model.value);
                details.textContent = `${payload.message}\n\n${JSON.stringify(payload.data, null, 2)}`;
                if (payload.image) { result.src = payload.image; result.hidden = false; } else result.hidden = true;
            } catch (error) { result.hidden = true; details.textContent = `错误：${error.message}`; } finally { predict.disabled = false; }
        });
        predictAll.addEventListener('click', async () => {
            if (!preview.src) { details.textContent = '请先选择图片。'; return; }
            if (availableModels.some(item => !isSam3(item.id)) && !annotations.length) { details.textContent = '测试全部模型前，请至少添加一个点或矩形，供 SAM/SAM 2/SAM 2.1 使用。'; return; }
            if (availableModels.some(item => isSam3(item.id)) && !document.querySelector('#caption').value.trim()) { details.textContent = '测试全部模型前，请填写文本提示，供 SAM 3/SAM 3.1 使用。'; return; }
            predict.disabled = predictAll.disabled = true; result.hidden = true; const reports = [];
            for (const item of availableModels) {
                details.textContent = `正在测试 ${item.name}…\n\n${reports.join('\n')}`;
                try { const payload = await runModel(item.id); reports.push(`✓ ${item.name}: ${payload.message}`); }
                catch (error) { reports.push(`✗ ${item.name}: ${error.message}`); }
            }
            details.textContent = `全部可用模型测试完成（${reports.length}/${availableModels.length} 已执行）：\n\n${reports.join('\n')}`;
            predict.disabled = predictAll.disabled = false;
        });
    </script>
</body>
</html>